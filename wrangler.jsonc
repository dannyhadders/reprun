{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reprun",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Runs on your free <name>.<account>.workers.dev address, behind Cloudflare Access (docs/SETUP.md).
  // Own domain? Set REPRUN_DOMAIN and REPRUN_DATABASE_ID as build variables in Cloudflare:
  // scripts/config.mjs then swaps workers.dev for your domain and pins your database at build time.
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    // API routes must reach the worker even on a full-page navigation (e.g. the Strava redirect).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reprun",
      // No database_id: Cloudflare creates the database on the first deploy.
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (Cloudflare dashboard, or `npx wrangler secret put NAME`):
  //   ALLOWED_EMAIL         the email you sign in to Cloudflare Access with; the API refuses anyone else
  //   ACCESS_TEAM, ACCESS_AUD   your Access team name and the app's Audience tag; the API then checks
  //                         Access's signed token. Needed on workers.dev, optional on your own domain
  //   STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET   optional, for Strava sync

  "env": {
    // The public demo (built with CLOUDFLARE_ENV=demo): made-up data, no sign-in, wiped at 03:00 UTC.
    // Not needed for your own copy; delete this block or point it at your own domain and database.
    "demo": {
      "workers_dev": false,
      "routes": [{ "pattern": "demo.danielhadaway.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reprun-demo",
          "database_id": "62ce7fcb-6e66-46d4-a3f9-573d3b0fe9a6",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "DEMO": "1" },
      "triggers": { "crons": ["0 3 * * *"] }
    },
    // Phone-only (built with CLOUDFLARE_ENV=local): no database and no sign-in. Each visitor's data stays in
    // their own browser (src/lib/local.ts), so the Worker only serves the app. Workers Builds: build `npm run build:local`,
    // deploy `npx wrangler deploy`. By hand: `npm run deploy:local` (a bare `wrangler deploy` ships whatever was built last).
    "local": {
      "workers_dev": false,
      // ponytail: old domain kept so phones that installed from it keep their data
      "routes": [
        { "pattern": "reprun.co.uk", "custom_domain": true },
        { "pattern": "reprun.danielhadaway.dev", "custom_domain": true }
      ]
    }
  }
}
